# What the sherpa-onnx runtime is built from. Change one of these and the
# build is a different build: say so in the commit, and bench it.

# sherpa-onnx, by commit; the tag is for people. Its CMake pins everything it
# downloads (ONNX Runtime's WebAssembly library, kaldi-native-fbank, …) by
# SHA-256, so the commit pins those too.
SHERPA_ONNX_TAG=v2.0.1
SHERPA_ONNX_COMMIT=af2d8d81dbfa61c4cea4c568da78f3982edca005

# Emscripten, as the official image pinned by digest. sherpa-onnx's own build
# notes say 4.0.23 is the version known to work.
EMSDK_VERSION=4.0.23
EMSDK_IMAGE=docker.io/emscripten/emsdk@sha256:86537645c51e44899812d29820ee3b64b96c321ebb2aba4416a04ceeb1bcde62
